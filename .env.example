# Vorlage für die Docker-Konfiguration: nach .env kopieren und die Werte anpassen.
# .env enthält Passwörter und wird nicht eingecheckt.

# Datenbank (wird beim ersten Start des MariaDB-Containers angelegt)
DB_USERNAME=admin_db
DB_PASSWORD=bitte-ein-sicheres-passwort
DB_ROOT_PASSWORD=bitte-ein-anderes-sicheres-passwort

# Erster Administrator der Anwendung (mindestens 8 Zeichen)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-ein-sicheres-admin-passwort

# Unterrichtsbeginn für die Verspätungsberechnung
UNTERRICHTSBEGINN=08:00

# Port auf dem Rechner, unter dem die Anwendung erreichbar ist
APP_PORT=8080
